{
  "name": "tba3-elements",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:lib": "ng build elements",
    "build:demo": "ng build demo",
    "build:docs": "ng build docs",
    "build": "npm run build:lib && npm run build:demo && npm run build:docs",
    "build:pages": "node scripts/build-pages.mjs",
    "start:demo": "ng serve --port 4220 demo",
    "start:docs": "ng serve --port 4221 docs",
    "test": "ng test elements",
    "generate:model": "npm run spec:proposed && openapi-typescript tba3-spec.proposed.yml -o projects/elements/src/lib/model/tba3-spec.ts",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,json,md}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,json,md}\" \"scripts/**/*.mjs\"",
    "spec:proposed": "node scripts/build-proposed-spec.mjs",
    "generate:model:original": "openapi-typescript tba3-spec.yml -o projects/elements/src/lib/model/tba3-spec.original.ts"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "bootstrap": "^5.3.8",
    "echarts": "^6.0.0",
    "ngx-echarts": "^21.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.23",
    "@angular/cli": "^21.2.23",
    "@angular/compiler-cli": "^21.2.0",
    "@ng-doc/app": "21.0.2",
    "@ng-doc/builder": "21.0.2",
    "@ng-doc/core": "21.0.2",
    "@ng-doc/ui-kit": "21.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "yaml": "^2.7.0"
  },
  "description": "Berichtselemente für TBA-III-konforme Auswertungsdaten (Angular, Bootstrap)"
}
